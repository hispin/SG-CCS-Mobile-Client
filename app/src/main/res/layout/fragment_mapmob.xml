<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:mapbox="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".fragments.MapmobFragment">

    <com.mapbox.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            mapbox:mapbox_cameraBearing="0"
            mapbox:mapbox_cameraTargetLat="32.941484"
            mapbox:mapbox_cameraTargetLng="35.795603"
            mapbox:mapbox_cameraZoom="16" />


    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fbRefresh1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="36dp"
            android:layout_marginBottom="36dp"
            android:contentDescription="@string/my_location"
            android:src="@drawable/ic_move_my_location"
            app:backgroundTint="@color/turquoise_blue" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fbClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="60dp"
            android:contentDescription="@string/clear_alarms"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/common_google_signin_btn_text_dark_focused"
            app:backgroundTint="@color/turquoise_blue" />

</FrameLayout>
