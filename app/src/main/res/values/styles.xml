<resources>

    <!-- Base application theme. -->

    <style name="AppTheme1" parent="Theme.AppCompat.Light.NoActionBar">
        <!--    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">-->
        <!-- Status bar stuff. -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- the screens of the activation (the background is painted by the window) -->
    <style name="AppTheme1.Gray">
        <item name="android:windowBackground">@color/gray1</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/gray1</item>
    </style>

    <style name="DateTimeDialog" parent="Theme.AppCompat.Dialog" />

    <style name="zone_title" parent="marquee">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="marquee">
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:scrollHorizontally">true</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:freezesText">true</item>
    </style>


    <!--style of tab layout-->

    <!--For list of popup menu -->
    <style name="winPopupAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/scale_down</item>
    </style>

    <!--style of text of tab layout-->



    <!--for content of menu of configuration screen-->
    <style name="configContentItem">
        <item name="android:textSize">13.3sp</item>
        <item name="android:textColor">@color/dark2</item>
        <item name="android:layout_marginStart">64.7dp</item>
    </style>




    <!--    <style name="MySpinner" parent="Theme.AppCompat.Light.DarkActionBar">-->
    <!--        <item name="android:dividerHeight">2dp</item>-->
    <!--        <item name="android:divider">#000</item>-->
    <!--    </style>-->

</resources>
